# Copie para .env e preencha com os dados do app web do seu projeto Firebase
# (Console > Configurações do projeto > Seus apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true para usar os emuladores locais (firebase emulators:start)
VITE_USE_EMULATORS=false
